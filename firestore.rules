rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper checks
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles: Only editable by the owner, allows changing isPro for trial demo upgrades
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }
    
    // System Config: Only readable by Pro subscribers, write disabled from client-side
    match /system/config {
      allow read: if isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPro == true;
      allow write: if false;
    }
    
    // Generated plans: Owner-locked read/write access
    match /users/{userId}/plans/{planId} {
      allow read, write: if isOwner(userId);
    }
  }
}
